{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sestet",
  "main": "server/app.mjs",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/product",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "vars": {
    "APP_ORIGIN": "https://sestet.emmachataigner.workers.dev",
    "SIGNUPS_ENABLED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sestet-private",
      "database_id": "d74981a6-c571-4666-9624-11e540e4e455",
      "migrations_dir": "server/migrations",
    },
  ],
}
